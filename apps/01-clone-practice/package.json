{
  "name": "@kevinxiao0210/myui",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/myui.umd.cjs",
  "module": "dist/myui.es.js",
  "types": "types/index.d.ts",
  "style": "dist/styles/myui.css",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/myui.es.js",
      "require": "./dist/myui.umd.cjs"
    },
    "./style.css": "./dist/styles/myui.css"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:style",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:style": "vite build --config vite.style.config.js"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "less": "^4.0.0",
    "vite": "^8.0.12",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "vue-router": "^4.6.4"
  }
}
